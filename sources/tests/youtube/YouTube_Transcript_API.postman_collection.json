{
	"info": {
		"_postman_id": "youtube-transcript-api-collection",
		"name": "YouTube Transcript API",
		"description": "Complete API collection for testing YouTube Transcript endpoints in the sources app.\n\nBase URL: http://127.0.0.1:8000\nAPI Path: /api/sources/youtube-transcripts/\n\nThis collection tests all CRUD operations, filtering, and custom actions.",
