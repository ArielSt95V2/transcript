	"item": [
		{
			"name": "List All Transcripts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response is an array\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"pm.test(\"Response time is less than 500ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(500);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/api/sources/youtube-transcripts/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"sources",
						"youtube-transcripts",
						""
					]
				},
				"description": "Retrieve a list of all YouTube transcripts in the database."
			},
			"response": []
		},
		{
			"name": "Create New Transcript",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200 or 201\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test(\"Response has id field\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    pm.expect(jsonData).to.have.property('video_id');",
							"    pm.expect(jsonData).to.have.property('status');",
							"    ",
							"    // Save for subsequent requests",
							"    pm.collectionVariables.set(\"transcript_id\", jsonData.id);",
							"    pm.collectionVariables.set(\"video_id\", jsonData.video_id);",
							"});",
							"",
							"pm.test(\"Video ID is extracted correctly\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.video_id).to.equal('dQw4w9WgXcQ');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Test Video Transcript\",\n  \"description\": \"This is a test transcript created via Postman\",\n  \"video_url\": \"https://www.youtube.com/watch?v=dQw4w9WgXcQ\",\n  \"language\": \"en\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/sources/youtube-transcripts/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"sources",
						"youtube-transcripts",
						""
					]
				},
				"description": "Create a new YouTube transcript. The video_id will be automatically extracted from the URL, and transcript extraction will begin automatically."
			},
			"response": []
		},
